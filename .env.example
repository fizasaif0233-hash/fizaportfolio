# Copy to .env.local and fill in your values (do not commit .env.local)

# --- Local dev (next dev): contact form uses /api/contact + Gmail ---
CONTACT_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GitHub Pages / static deploy: use Formspree (recommended) or Web3Forms ---
# Formspree works with github.io. Create form at https://formspree.io, get form ID from the endpoint (e.g. xjvqklop from .../f/xjvqklop). Add secret NEXT_PUBLIC_FORMSPREE_FORM_ID.
NEXT_PUBLIC_FORMSPREE_FORM_ID=your-formspree-form-id
# Web3Forms may block free subdomains like github.io; use if you have a custom domain or paid plan.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
