# Copy to .env.local and fill in your values (do not commit .env.local)

# --- Local dev (next dev): contact form uses /api/contact + Gmail ---
CONTACT_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GitHub Pages / static deploy: contact form uses Web3Forms (no server) ---
# Get a free key at https://web3forms.com and add your email there.
# Then set this in GitHub repo: Settings → Secrets and variables → Actions →
# add NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY, and in your workflow pass it to the build.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
